# CloudServe Support Automation — environment template.
#
# Copy this file to .env and fill in your own values:
#     cp .env.example .env          (macOS / Linux)
#     Copy-Item .env.example .env   (Windows PowerShell)
#
# .env is listed in .gitignore and must never be committed.
# Every variable below is optional: the system runs with none of them set.

# --- Model provider (optional) ------------------------------------------
# Without a key the system generates answers locally from the retrieved
# documentation. That is a supported mode, not a degraded one, and the
# evaluation harness runs fully in it.
OPENROUTER_API_KEY=your_openrouter_api_key_here
MODEL_NAME=meta-llama/llama-3.1-8b-instruct

# --- Routing -------------------------------------------------------------
# Automation-readiness threshold. Selected by cost minimisation over the
# development set; see evaluation/results/calibration.md section 5.
CONFIDENCE_THRESHOLD=0.45

# --- Logging -------------------------------------------------------------
LOG_LEVEL=INFO
